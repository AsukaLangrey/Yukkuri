; Application identifier remains stable to preserve existing local save paths.
; The playable M01 scene sets its own visible window title at startup.
config_version=5

[application]
config/name="油库里乐园 · 基础框架"
run/main_scene="res://InteractionRoom.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[physics]
3d/physics_engine="Jolt Physics"

[dotnet]
project/assembly_name="Yukkuri.Game"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.055, 0.085, 0.12, 1)
