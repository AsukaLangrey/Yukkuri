* text=auto
*.cs text eol=lf
*.csproj text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.blend filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text

# Runtime input bytes are pinned by the asset manifest.
assets/art/runtime/** -text
assets/audio/runtime/** -text
assets/fonts/runtime/** -text
assets/art/production/starter-garden/*.png -text
archive/superseded-docs/originals/** -text
